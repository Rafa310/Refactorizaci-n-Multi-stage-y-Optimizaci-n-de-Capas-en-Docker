{
  "name": "kodigo/laravel-docker-demo",
  "description": "Minimal Laravel 12 REST API for Docker + MySQL assessment",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {"sort-packages": true, "optimize-autoloader": true, "allow-plugins": {}}
}
